# Levito — Notion integration configuration.
# Copy to .env.local and fill in real values. .env.local is gitignored.

# Internal integration token (ntn_...). Keep server-side only — never expose to the browser.
NOTION_API_KEY=

# Parent Notion page under which Levito databases are provisioned.
# Accepts a page ID or full Notion URL (dashes optional).
NOTION_ROOT_PAGE_ID=

# Notion API version. Default: 2026-03-11
NOTION_VERSION=2026-03-11

# Data source IDs — written automatically by `npm run notion:setup`.
# For existing workspaces you may point these at your own data sources instead;
# field mapping is resolved by property name (see Settings → Data source).
NOTION_DS_MEMBERS=
NOTION_DS_INITIATIVES=
NOTION_DS_KNOWLEDGE=
NOTION_DS_DECISIONS=
NOTION_DS_HANDOVER_ACTIONS=
NOTION_DS_HANDOVERS=

# Levito configuration page (organization details + review policy). Created by notion:setup.
NOTION_CONFIG_PAGE_ID=

# Optional: override the local demo data file used when NOTION_API_KEY is absent.
# LEVITO_DEMO_FILE=.data/levito-demo.json
